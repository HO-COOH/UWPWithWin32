<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(VisualStudioVersion)' == '' or '$(VisualStudioVersion)' &lt; '15.0'">
    <VisualStudioVersion>15.0</VisualStudioVersion>
  </PropertyGroup>
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x86">
      <Configuration>Debug</Configuration>
      <Platform>x86</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x86">
      <Configuration>Release</Configuration>
      <Platform>x86</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM">
      <Configuration>Debug</Configuration>
      <Platform>ARM</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM">
      <Configuration>Release</Configuration>
      <Platform>ARM</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|AnyCPU">
      <Configuration>Debug</Configuration>
      <Platform>AnyCPU</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|AnyCPU">
      <Configuration>Release</Configuration>
      <Platform>AnyCPU</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup>
    <WapProjPath Condition="'$(WapProjPath)'==''">$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\</WapProjPath>
  </PropertyGroup>
  <Import Project="$(WapProjPath)\Microsoft.DesktopBridge.props" />
  <PropertyGroup>
    <ProjectGuid>562b4acb-592a-435b-8deb-19f1c2765cfa</ProjectGuid>
    <TargetPlatformVersion>10.0.26100.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <DefaultLanguage>en-US</DefaultLanguage>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <!-- Disable validation to bypass APPX0501 since we force-patch the manifest -->
    <AppxPackageValidationEnabled>false</AppxPackageValidationEnabled>
    <NoWarn>$(NoWarn);NU1702</NoWarn>
    <EntryPointProjectUniqueName>..\UWPMain\UWPMain.vcxproj</EntryPointProjectUniqueName>
  </PropertyGroup>
  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>
  <ItemGroup>
    <Content Include="Images\SplashScreen.scale-200.png" />
    <Content Include="Images\LockScreenLogo.scale-200.png" />
    <Content Include="Images\Square150x150Logo.scale-200.png" />
    <Content Include="Images\Square44x44Logo.scale-200.png" />
    <Content Include="Images\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Images\StoreLogo.png" />
    <Content Include="Images\Wide310x150Logo.scale-200.png" />
  </ItemGroup>
  <Target Name="PatchManifest" AfterTargets="_GenerateAppxManifest" BeforeTargets="_ValidateAppxManifest">
    <PropertyGroup>
       <ObjManifestPath>$(ProjectDir)$(IntermediateOutputPath)AppxManifest.xml</ObjManifestPath>
       <BinManifestPath>$(ProjectDir)$(OutputPath)AppxManifest.xml</BinManifestPath>
    </PropertyGroup>
    <Message Text="Patching manifest using PowerShell at: $(ObjManifestPath) and $(BinManifestPath)" Importance="high" />
    
    <Exec Command="powershell -Command &quot;&amp; { function Patch-File($path) { if (-not (Test-Path $path)) { Write-Host 'File not found: ' $path; return }; $xml = [xml](Get-Content $path); $ns = New-Object System.Xml.XmlNamespaceManager($xml.NameTable); $ns.AddNamespace('x', 'http://schemas.microsoft.com/appx/manifest/foundation/windows10'); $ns.AddNamespace('uap5', 'http://schemas.microsoft.com/appx/manifest/uap/windows10/5'); $ns.AddNamespace('uap10', 'http://schemas.microsoft.com/appx/manifest/uap/windows10/10'); $nodes = $xml.SelectNodes('/x:Package/x:Applications/x:Application', $ns); foreach ($node in $nodes) { $node.RemoveAttribute('EntryPoint'); $node.SetAttribute('EntryPoint', 'UWPMain.App'); $node.SetAttribute('Executable', 'UWPMain.exe'); $node.RemoveAttribute('RuntimeBehavior', 'http://schemas.microsoft.com/appx/manifest/uap/windows10/10'); $node.RemoveAttribute('TrustLevel', 'http://schemas.microsoft.com/appx/manifest/uap/windows10/10'); Write-Host 'Reverted Client to Standard UWP.'; }; $serverNodes = $xml.SelectNodes('//uap5:OutOfProcessServer', $ns); foreach ($serverNode in $serverNodes) { $serverNode.SetAttribute('RunFullTrust', 'true'); $pathNode = $serverNode['uap5:Path']; if ($pathNode) { $pathNode.InnerText = 'ConsoleMain.exe'; Write-Host 'Updated Server Path to ConsoleMain.exe'; } $instancingNode = $serverNode['uap5:Instancing']; if ($instancingNode) { $instancingNode.InnerText = 'multipleInstances'; Write-Host 'Updated Instancing to multipleInstances'; } Write-Host 'Restored RunFullTrust to OutOfProcessServer.'; }; $xml.Save($path); Write-Host 'Successfully patched: ' $path; }; Patch-File '$(BinManifestPath)'; }&quot;" />
  </Target>
  <Import Project="$(WapProjPath)\Microsoft.DesktopBridge.targets" />
  <!-- Overriding the validation target to be empty to bypass the rigorous checks that don't support our FullTrust+OOP setup -->
  <Target Name="_ValidateAppxManifest">
    <Message Text="Skipping manifest validation to allow custom FullTrust configuration." Importance="high" />
  </Target>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ConsoleMain\ConsoleMain.vcxproj" />
    <ProjectReference Include="..\UWPMain\UWPMain.vcxproj">
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
      <TrustLevel>MediumIL</TrustLevel>
    </ProjectReference>
  </ItemGroup>
</Project>